{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HinoVerse",
  "version": "0.1.0",
  "identifier": "ru.hinoverse.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:native"
  },
  "app": {
    "windows": [
      {
        "title": "HinoVerse — японский с нуля",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "publisher": "HinoVerse",
    "shortDescription": "Японский язык с нуля до свободного общения",
    "longDescription": "Кана, кандзи, грамматика N5–N1, произношение, разговоры с ИИ, виртуальная Япония и пробные экзамены JLPT.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
